# App
APP_ENV=development
DATABASE_URL=sqlite:///./enterprise_research_agent.db
REPORT_FRESHNESS_DAYS=30
CV_TEXT_MAX_CHARACTERS=50000

# Search
# Use "mock" for local development without external services.
# Use "tavily" for real company research.
SEARCH_PROVIDER=mock
SEARCH_PROVIDER_API_KEY=
TAVILY_API_KEY=
RESEARCH_SEARCH_CONCURRENCY=4
RESEARCH_EXTRACT_CONCURRENCY=6
RESEARCH_RESULTS_PER_QUERY=3
RESEARCH_SEARCH_TIMEOUT_SECONDS=12
RESEARCH_EXTRACT_TIMEOUT_SECONDS=8
RESEARCH_ENABLE_DEEPENING=true
RESEARCH_MAX_EXTRACT_URLS=12
RESEARCH_EXTRACT_PROTECTED_DOMAINS=false
RESEARCH_MAX_EXTRACT_URLS_PER_TOPIC=2

# LLM synthesis through Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
RAG_TOP_K=8
